    {
      "id": "line_based_device_steps",
      "purpose": "逐行步骤脚本，检查系统不会强行压成固定五镜。",
      "script_text": "1. 少年在室内空间打开旧手机，屏幕显示断裂的信号。\n2. 少年低头检查手机背面的裂痕。\n3. 少年把手机接到电脑旁边的线缆。\n4. 屏幕突然闪烁，房间灯光变暗。\n5. 少年听见门外有人靠近。\n6. 少年拔下手机，把它藏进书里。\n7. 门把手轻轻转动。\n8. 少年关掉台灯，躲到窗帘后。\n9. 手机再次震动，屏幕照亮他的脸。\n10. 少年屏住呼吸，等待脚步声远离。",
      "expected_shot_range": [
        8,
        10
      ],
      "expected_assets": [
        {
          "label": "少年",
          "asset_type": "character"
        },
        {
          "label": "室内空间",
          "asset_type": "scene"
        }
      ],
      "quality_focus": [
        "line_based_script",
        "anti_fixed_template",
        "device_prop_continuity"
      ]
    },
