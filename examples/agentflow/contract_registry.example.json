  "validation_rules": [
    {
      "rule_id": "schema_version_0_1_0",
      "description": "AgentFlow contract examples must declare schema_version 0.1.0."
    },
    {
      "rule_id": "example_path_exists",
      "description": "Every registry entry must point to a committed minimal example."
    },
    {
      "rule_id": "no_private_paths_or_secrets",
      "description": "Examples must not include private local paths, generated media, credentials, tokens, cookies, or signed URLs."
    },
    {
      "rule_id": "router_decision_only",
      "description": "Router decisions record selection reasoning and must not claim skill execution."
    },
    {
      "rule_id": "candidate_memory_only",
      "description": "Memory candidates remain candidate-only until an explicit promotion decision exists."
    },
    {
      "rule_id": "reusable_asset_requires_promotion",
      "description": "Reusable asset profiles must reference an explicit promotion decision."
    },
    {
      "rule_id": "promotion_decision_required_for_context_reuse",
      "description": "Preference profiles, context bundles, and next-round prompts may reuse candidate memory only through explicit promotion decision references."
    },
    {
      "rule_id": "context_reuse_no_durable_write",
      "description": "Context reuse artifacts are review inputs and must keep writes_long_term_memory false."
    },
    {
      "rule_id": "evidence_reuse_traceability_first",
      "description": "Evidence reuse reviews validate source-to-context traceability before claiming quality improvement."
    },
    {
      "rule_id": "production_memory_loop_no_provider_context_bundle",
      "description": "Production-memory loops build next-context bundles from validated source records without provider calls or durable memory writes."
    },
    {
      "rule_id": "company_kb_feedback_candidates_not_written",
      "description": "Company KB feedback candidate packets summarize project lessons without writing source Company knowledge or promoting company memory."
    },
    {
      "rule_id": "local_agentops_non_claims",
      "description": "Local AgentOps artifacts must include non-claims for human acceptance, business validation, and durable memory."
    },
    {
      "rule_id": "local_agentops_no_company_write",
      "description": "Local AgentOps artifacts are evidence surfaces and must not write Company/COS memory."
    },
    {
      "rule_id": "asset_reuse_decision_only",
      "description": "Asset reuse decisions record selection reasoning and must not execute work."
    }
  ],
