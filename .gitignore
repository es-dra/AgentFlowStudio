!data/processed/.gitkeep
!data/outputs/.gitkeep
!data/reports/.gitkeep

# media
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.flac

# generated
/outputs/
/artifacts/
/runs/

# node and tool caches
node_modules/
.claude-data/
.codex/
.cache/

# secrets
*.key
*.pem
*.p12
