{
  "schema_version": "company_provider_secrets.local.v2",
  "accounts": {
    "local_codex": {
      "auth_type": "none",
      "execution_backend": "codex_exec",
      "cli_command": "codex",
      "timeout_sec": 180,
      "default_models": {
        "llm": "codex-local",
        "vision": "codex-local",
        "image": "image2"
      }
    },
    "fake_video": {
      "auth_type": "none",
      "base_url": "https://video.example.invalid",
      "default_models": {
        "video": "fake-video"
      }
    },
    "kling": {
      "auth_type": "jwt_hs256_from_ak_sk",
      "base_url": "https://api-beijing.klingai.com",
      "access_key_env": "KLING_ACCESS_KEY",
      "secret_key_env": "KLING_SECRET_KEY",
      "jwt": {
        "ttl_seconds": 1800,
        "nbf_skew_seconds": -5
      },
      "default_models": {
        "i2v": "kling-v3"
      },
      "endpoints": {
        "i2v_create": "/v1/videos/image2video",
        "i2v_query": "/v1/videos/image2video/{id}"
      }
    }
  },
  "account_pools": {
    "prompt_optimizer_pool": {
      "accounts": [
        {
          "account_id": "local_codex",
          "service_id": "prompt_optimizer",
          "enabled_capabilities": ["llm"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "codex_image_pool": {
      "accounts": [
        {
          "account_id": "local_codex",
          "service_id": "codex_image",
          "enabled_capabilities": ["image"],
          "enabled": true,
          "priority": 20,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "vision_pool": {
      "accounts": [
        {
          "account_id": "local_codex",
          "service_id": "vision_image",
          "enabled_capabilities": ["vision"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        },
        {
          "account_id": "local_codex",
          "service_id": "vision_video",
          "enabled_capabilities": ["vision"],
          "enabled": true,
          "priority": 20,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "video_pool": {
      "accounts": [
        {
          "account_id": "fake_video",
          "service_id": "fake_video",
          "enabled_capabilities": ["video"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "kling_video_pool": {
      "accounts": [
        {
          "account_id": "kling",
          "service_id": "kling_i2v",
          "credential_env": null,
          "enabled_capabilities": ["video"],
          "enabled": true,
          "priority": 20,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    }
  },
  "services": {
    "prompt_optimizer": {
      "provider": "codex_local",
      "account_ref": "local_codex",
      "capability": "llm",
      "required_gate": "AFS_ALLOW_REMOTE_LLM",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "llm",
        "execution_mode": "sync",
        "capabilities": ["llm"],
        "account_pool_id": "prompt_optimizer_pool",
        "reference_image_slots": 0,
        "supported_aspect_ratios": ["1:1"],
        "prompt_char_limit": 5000,
        "seed_supported": false,
        "cost_hint": "Prompt optimization provider is server-configured and intentionally not product-facing.",
        "rate_limit_hint": "Prompt enhancement should be manually gated and sampled before bulk use.",
        "required_gate": "AFS_ALLOW_REMOTE_LLM"
      }
    },
    "codex_image": {
      "provider": "codex_handoff",
      "account_ref": "local_codex",
      "capability": "image",
      "required_gate": "AFS_ALLOW_REMOTE_IMAGE",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "image",
        "execution_mode": "async",
        "capabilities": ["image"],
        "account_pool_id": "codex_image_pool",
        "reference_image_slots": 4,
        "supported_aspect_ratios": ["1:1", "4:3", "3:4", "16:9", "9:16"],
        "prompt_char_limit": 4000,
        "seed_supported": true,
        "cost_hint": "Server-local Codex worker. Downstream Image2/API usage is controlled by server setup.",
        "rate_limit_hint": "Use one worker process per Runtime root during MVP validation.",
        "required_gate": "AFS_ALLOW_REMOTE_IMAGE",
        "async_poll_interval_sec": 2,
        "async_timeout_sec": 900,
        "async_max_polls": 450
      }
    },
    "vision_image": {
      "provider": "codex_local",
      "account_ref": "local_codex",
      "capability": "vision",
      "required_gate": "AFS_ALLOW_REMOTE_VISION",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "vision",
        "execution_mode": "sync",
        "capabilities": ["vision"],
        "account_pool_id": "vision_pool",
        "reference_image_slots": 8,
        "supported_aspect_ratios": ["1:1"],
        "prompt_char_limit": 3000,
        "seed_supported": false,
        "cost_hint": "Image visual understanding is server-configured; outputs must remain draft evidence.",
        "rate_limit_hint": "Run one visual-inspection request at a time during MVP validation.",
        "required_gate": "AFS_ALLOW_REMOTE_VISION"
      }
    },
    "vision_video": {
      "provider": "codex_local",
      "account_ref": "local_codex",
      "capability": "vision",
      "required_gate": "AFS_ALLOW_REMOTE_VISION",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "vision",
        "execution_mode": "sync",
        "capabilities": ["vision"],
        "account_pool_id": "vision_pool",
        "reference_image_slots": 8,
        "supported_aspect_ratios": ["16:9", "9:16", "1:1"],
        "prompt_char_limit": 5000,
        "seed_supported": false,
        "cost_hint": "Video visual understanding should prefer sampled-frame timelines before direct video-model calls.",
        "rate_limit_hint": "Keep video inspection sampled and evidence-bound before any provider-direct path.",
        "required_gate": "AFS_ALLOW_REMOTE_VISION"
      }
    },
    "fake_video": {
      "provider": "fake",
      "account_ref": "fake_video",
      "capability": "video",
      "required_gate": "AFS_ALLOW_REMOTE_VIDEO",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "video",
        "execution_mode": "async",
        "capabilities": ["video"],
        "account_pool_id": "video_pool",
        "reference_image_slots": 1,
        "supported_aspect_ratios": ["16:9", "9:16"],
        "prompt_char_limit": 2000,
        "seed_supported": false,
        "cost_hint": "Fake adapter only; no provider cost.",
        "rate_limit_hint": "Fake adapter is deterministic and local.",
        "required_gate": "AFS_ALLOW_REMOTE_VIDEO"
      }
    },
    "kling_i2v": {
      "provider": "kling",
      "account_ref": "kling",
      "capability": "video",
      "api_family": "i2v",
      "default_model_ref": "accounts.kling.default_models.i2v",
      "create_endpoint_ref": "accounts.kling.endpoints.i2v_create",
      "query_endpoint_ref": "accounts.kling.endpoints.i2v_query",
      "required_gate": "AFS_ALLOW_REMOTE_VIDEO",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.2",
        "modality": "video",
        "execution_mode": "async",
        "capabilities": ["video"],
        "account_pool_id": "kling_video_pool",
        "reference_image_slots": 2,
        "supported_aspect_ratios": ["16:9", "9:16"],
        "prompt_char_limit": 2500,
        "seed_supported": false,
        "cost_hint": "Kling I2V live usage is billed by provider duration and mode.",
        "rate_limit_hint": "Use one live Kling video task at a time during MVP validation.",
        "required_gate": "AFS_ALLOW_REMOTE_VIDEO",
        "frame_slots": {
          "first_frame": "required",
          "last_frame": "optional"
        },
        "frame_modes": ["first_frame", "first_last_frame"],
        "supported_durations_sec": [5, 10],
        "supported_resolutions": ["720p", "1080p"],
        "async_poll_interval_sec": 5,
        "async_timeout_sec": 600,
        "async_max_polls": 120,
        "prompt_profile": "video_i2v_v1",
        "cost_estimate": {
          "unit": "task",
          "disclaimer": "Example only; use local provider terms for actual cost."
        }
      }
    }
  }
}
