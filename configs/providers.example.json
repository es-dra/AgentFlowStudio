{
  "schema_version": "company_provider_secrets.local.v2",
  "accounts": {
    "local_codex": {
      "auth_type": "none",
      "execution_backend": "codex_exec",
      "cli_command": "codex",
      "timeout_sec": 180,
      "default_models": {
        "llm": "codex-local",
        "vision": "codex-local",
        "image": "image2"
      }
    },
    "image_relay": {
      "auth_type": "api_key",
      "base_url_env": "AFS_IMAGE_RELAY_BASE_URL",
      "api_key_env": "AFS_IMAGE_RELAY_API_KEY",
      "default_models": {
        "image": "gpt-image-2"
      }
    },
    "fake_video": {
      "auth_type": "none",
      "base_url": "https://video.example.invalid",
      "default_models": {
        "video": "fake-video"
      }
    },
    "volc_seedance_relay": {
      "auth_type": "api_key",
      "base_url_env": "AFS_VIDEO_RELAY_BASE_URL",
      "api_key_env": "AFS_VIDEO_RELAY_API_KEY",
      "default_models": {
        "video": "doubao-seedance-2-0"
      }
    },
    "audio_relay": {
      "auth_type": "api_key",
      "base_url_env": "AFS_AUDIO_RELAY_BASE_URL",
      "api_key_env": "AFS_AUDIO_RELAY_API_KEY",
      "default_models": {
        "audio": "gpt-4o-mini-tts"
      }
    }
  },
  "account_pools": {
    "prompt_optimizer_pool": {
      "accounts": [
        {
          "account_id": "local_codex",
          "service_id": "prompt_optimizer",
          "enabled_capabilities": ["llm"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "image_relay_pool": {
      "accounts": [
        {
          "account_id": "image_relay",
          "service_id": "image_relay",
          "credential_env": "AFS_IMAGE_RELAY_API_KEY",
          "enabled_capabilities": ["image"],
          "enabled": true,
          "priority": 20,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "vision_pool": {
      "accounts": [
        {
          "account_id": "local_codex",
          "service_id": "vision_image",
          "enabled_capabilities": ["vision"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        },
        {
          "account_id": "local_codex",
          "service_id": "vision_video",
          "enabled_capabilities": ["vision"],
          "enabled": true,
          "priority": 20,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "video_pool": {
      "accounts": [
        {
          "account_id": "fake_video",
          "service_id": "fake_video",
          "enabled_capabilities": ["video"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "seedance_video_pool": {
      "accounts": [
        {
          "account_id": "volc_seedance_relay",
          "service_id": "seedance_i2v",
          "credential_env": "AFS_VIDEO_RELAY_API_KEY",
          "enabled_capabilities": ["video"],
          "enabled": true,
          "priority": 15,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    },
    "audio_relay_pool": {
      "accounts": [
        {
          "account_id": "audio_relay",
          "service_id": "tts_relay",
          "credential_env": "AFS_AUDIO_RELAY_API_KEY",
          "enabled_capabilities": ["audio"],
          "enabled": true,
          "priority": 10,
          "weight": 1,
          "concurrency_limit": 1,
          "health_state": "unknown"
        }
      ]
    }
  },
  "services": {
    "prompt_optimizer": {
      "provider": "codex_local",
      "account_ref": "local_codex",
      "capability": "llm",
      "required_gate": "AFS_ALLOW_REMOTE_LLM",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.3",
        "modality": "llm",
        "execution_mode": "sync",
        "capabilities": ["llm"],
        "account_pool_id": "prompt_optimizer_pool",
        "reference_image_slots": 0,
        "supported_aspect_ratios": ["1:1"],
        "prompt_char_limit": 5000,
        "seed_supported": false,
        "cost_hint": "Prompt optimization provider is server-configured and intentionally not product-facing.",
        "rate_limit_hint": "Prompt enhancement should be manually gated and sampled before bulk use.",
        "required_gate": "AFS_ALLOW_REMOTE_LLM"
      }
    },
    "image_relay": {
      "provider": "api_relay",
      "account_ref": "image_relay",
      "capability": "image",
      "endpoint": "/images/generations",
      "edit_endpoint": "/images/edits",
      "request_format": "openai_images",
      "model": "gpt-image-2",
      "quality": "low",
      "output_format": "png",
      "required_gate": "AFS_ALLOW_REMOTE_IMAGE",
      "allowed_artifact_hosts": [
        ".example.invalid"
      ],
      "descriptor": {
        "schema_version": "provider_descriptor.v0.3",
        "modality": "image",
        "execution_mode": "sync",
        "capabilities": ["image"],
        "account_pool_id": "image_relay_pool",
        "reference_image_slots": 4,
        "supported_aspect_ratios": ["1:1", "4:3", "3:4", "16:9", "9:16"],
        "prompt_char_limit": 6000,
        "seed_supported": false,
        "image_edit_capabilities": {
          "supports_image_edit": true,
          "supports_true_local_edit": false,
          "supports_preserve_locks": "prompt_only",
          "supports_negative_locks": "prompt_only",
          "fallback_modes": ["provider_full_frame_edit"],
          "max_reference_images": 4,
          "input_fidelity_modes": [],
          "local_edit_truth_label": "provider_full_frame_edit"
        },
        "cost_hint": "External image relay. Usage and billing are controlled by the configured relay account.",
        "rate_limit_hint": "Keep one live image/keyframe smoke at a time during MVP validation.",
        "required_gate": "AFS_ALLOW_REMOTE_IMAGE"
      }
    },
    "vision_image": {
      "provider": "codex_local",
      "account_ref": "local_codex",
      "capability": "vision",
      "required_gate": "AFS_ALLOW_REMOTE_VISION",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "vision",
        "execution_mode": "sync",
        "capabilities": ["vision"],
        "account_pool_id": "vision_pool",
        "reference_image_slots": 8,
        "supported_aspect_ratios": ["1:1"],
        "prompt_char_limit": 3000,
        "seed_supported": false,
        "cost_hint": "Image visual understanding is server-configured; outputs must remain draft evidence.",
        "rate_limit_hint": "Run one visual-inspection request at a time during MVP validation.",
        "required_gate": "AFS_ALLOW_REMOTE_VISION"
      }
    },
    "vision_video": {
      "provider": "codex_local",
      "account_ref": "local_codex",
      "capability": "vision",
      "required_gate": "AFS_ALLOW_REMOTE_VISION",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "vision",
        "execution_mode": "sync",
        "capabilities": ["vision"],
        "account_pool_id": "vision_pool",
        "reference_image_slots": 8,
        "supported_aspect_ratios": ["16:9", "9:16", "1:1"],
        "prompt_char_limit": 5000,
        "seed_supported": false,
        "cost_hint": "Video visual understanding should prefer sampled-frame timelines before direct video-model calls.",
        "rate_limit_hint": "Keep video inspection sampled and evidence-bound before any provider-direct path.",
        "required_gate": "AFS_ALLOW_REMOTE_VISION"
      }
    },
    "fake_video": {
      "provider": "fake",
      "account_ref": "fake_video",
      "capability": "video",
      "required_gate": "AFS_ALLOW_REMOTE_VIDEO",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "video",
        "execution_mode": "async",
        "capabilities": ["video"],
        "account_pool_id": "video_pool",
        "reference_image_slots": 1,
        "supported_aspect_ratios": ["16:9", "9:16"],
        "prompt_char_limit": 2000,
        "seed_supported": false,
        "cost_hint": "Fake adapter only; no provider cost.",
        "rate_limit_hint": "Fake adapter is deterministic and local.",
        "required_gate": "AFS_ALLOW_REMOTE_VIDEO"
      }
    },
    "seedance_i2v": {
      "provider": "volc_seedance",
      "account_ref": "volc_seedance_relay",
      "capability": "video",
      "endpoint": "/volc/v1/contents/generations/tasks",
      "model": "doubao-seedance-2-0",
      "required_gate": "AFS_ALLOW_REMOTE_VIDEO",
      "reference_roles": ["first_frame", "last_frame"],
      "watermark": false,
      "generate_audio": false,
      "descriptor": {
        "schema_version": "provider_descriptor.v0.2",
        "modality": "video",
        "execution_mode": "async",
        "capabilities": ["video"],
        "account_pool_id": "seedance_video_pool",
        "reference_image_slots": 2,
        "supported_aspect_ratios": ["16:9", "9:16", "1:1", "4:3", "3:4"],
        "prompt_char_limit": 5000,
        "seed_supported": true,
        "cost_hint": "Volc/Seedance relay usage is billed by provider duration and selected model.",
        "rate_limit_hint": "Use one live Seedance video task at a time during MVP validation.",
        "required_gate": "AFS_ALLOW_REMOTE_VIDEO",
        "frame_slots": {
          "first_frame": "required",
          "last_frame": "optional"
        },
        "frame_modes": ["first_frame", "first_last_frame"],
        "supported_durations_sec": [5, 10],
        "supported_resolutions": ["480p", "720p"],
        "async_poll_interval_sec": 5,
        "async_timeout_sec": 900,
        "async_max_polls": 180,
        "prompt_profile": "video_i2v_v1",
        "cost_estimate": {
          "unit": "task",
          "disclaimer": "Example only; use local provider terms for actual cost."
        }
      }
    },
    "tts_relay": {
      "provider": "openai_compatible_tts",
      "account_ref": "audio_relay",
      "capability": "audio",
      "endpoint": "/audio/speech",
      "model": "gpt-4o-mini-tts",
      "voice": "coral",
      "response_format": "wav",
      "required_gate": "AFS_ALLOW_REMOTE_AUDIO",
      "descriptor": {
        "schema_version": "provider_descriptor.v0.1",
        "modality": "audio",
        "execution_mode": "sync",
        "capabilities": ["audio"],
        "account_pool_id": "audio_relay_pool",
        "reference_image_slots": 0,
        "supported_aspect_ratios": ["1:1"],
        "prompt_char_limit": 4000,
        "seed_supported": false,
        "cost_hint": "OpenAI-compatible TTS relay. Usage and billing are controlled by the configured relay account.",
        "rate_limit_hint": "Keep one live speech synthesis request at a time during alpha validation.",
        "required_gate": "AFS_ALLOW_REMOTE_AUDIO",
        "cost_estimate": {
          "unit": "character",
          "currency": "CNY",
          "disclaimer": "Example only; use local provider terms for actual cost."
        }
      }
    }
  }
}
